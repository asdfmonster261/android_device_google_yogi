# Props stock sets in its product build.prop for Google's apps: setup wizard, Quick Start,
# Gboard, Turbo, the Pixel launcher, GMS tracing and crash reports. They are set only when
# a GApps package marks itself with ro.opa.eligible_device=true, which this build never
# sets; MindTheGapps sets it on init and BiTGApps in build.prop. The AppSearch pair also
# needs the virtualization framework, which this build leaves out, so it does nothing yet.
#
# late-init rather than a bare property trigger: a trigger on a prop that is already set
# when boot starts fires only after the boot trigger, with zygote already started.
on late-init && property:ro.opa.eligible_device=true
    setprop setupwizard.feature.show_digital_warranty true
    setprop ro.atrace.core.services com.google.android.gms,com.google.android.gms.ui,com.google.android.gms.persistent
    setprop ro.error.receiver.system.apps com.google.android.gms
    setprop ro.setupwizard.enterprise_mode 1
    setprop ro.setupwizard.esim_cid_ignore 00000001
    setprop setupwizard.feature.baseline_setupwizard_enabled true
    setprop setupwizard.feature.show_pai_screen_in_main_flow.carrier1839 false
    setprop setupwizard.feature.skip_button_use_mobile_data.carrier1839 true
    setprop aoj.feature.contract true
    setprop aoj.feature.node_logging true
    setprop ro.com.google.ime.theme_id 5
    setprop setupwizard.feature.show_pixel_tos true
    setprop ro.storage_manager.show_opt_in false
    setprop setupwizard.feature.show_support_link_in_deferred_setup false
    setprop setupwizard.feature.enable_wifi_tracker true
    setprop ro.hotword.detection_service_required false
    setprop setupwizard.feature.portal_notification true
    setprop setupwizard.feature.lifecycle_refactoring true
    setprop setupwizard.feature.notification_refactoring true
    setprop pixel_legal_joint_permission true
    setprop setupwizard.feature.default_locale_enhancement_enabled true
    setprop setupwizard.feature.locale_agnostic_enabled true
    setprop setupwizard.feature.enable_quick_start_flow true
    setprop setupwizard.feature.enable_parental_notice_activity true
    setprop setupwizard.feature.enable_parental_setup true
    setprop setupwizard.feature.osmigration true
    setprop charging_string.apply_lotx true
    setprop pixel_legal_joint_permission_v2 true
    setprop setupwizard.personal_safety_suw_enabled true
    setprop charging_string.apply_v2 true
    setprop setupwizard.feature.enable_restore_anytime true
    setprop setupwizard.feature.is_suw_onboarding_contract_enabled true
    setprop setupwizard.feature.joined_up_loading true
    setprop setupwizard.feature.device_info_icon_enabled true
    setprop setupwizard.feature.enable_gil_logging true
    setprop setupwizard.feature.enhanced_setup_design_metrics true
    setprop com.google.android.setupwizard.complianceDate 2026-04-01
    setprop turbo.feature.shutdown_exp true
    setprop setupwizard.feature.multiworker true
    setprop setupwizard.feature.one_tap_enabled true
    setprop setupwizard.feature.enable_delightful_setup true
    setprop ro.appsearch.feature.enable_isolated_storage true
    setprop ro.appsearch.feature.override_isolated_storage_migration_freeze true
    setprop ro.launcher.blur.appLaunch 0
    setprop setupwizard.feature.provisioning_profile_mode true
    setprop setupwizard.feature.enable_setup_companion true
    setprop ro.quick_start.oem_id 00e0
    setprop ro.quick_start.device_id yogi
