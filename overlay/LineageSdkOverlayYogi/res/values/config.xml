<?xml version="1.0" encoding="utf-8"?>
<!-- Ours, not recovered from stock. The wireless charger HAL and the whole wlcin power
     supply stack are present, so the setting belongs in the UI. LongScreen is opt-in per
     app and only matters on the cover panel, which is 1080x2342; the inner one is nearly
     square at 2152x2076 and no app would want stretching there. -->
<resources>
    <string-array name="config_restartActionsList">
        <item>restart</item>
        <item>restart_recovery</item>
        <item>restart_fastboot</item>
        <item>restart_bootloader</item>
    </string-array>
    <bool name="config_deviceSupportsWirelessCharging">true</bool>
    <bool name="config_haveHigherAspectRatioScreen">true</bool>
</resources>
