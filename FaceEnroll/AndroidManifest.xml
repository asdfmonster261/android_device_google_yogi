<!-- Runs as the system user, as stock's enroll app does. The face HAL calls into the
     preview window this app hands it, and the policy lets the face HAL call system
     apps, not platform apps. The platform certificate is what allows a non-privileged
     app to join the system user. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="org.lineageos.faceenroll"
          android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.MANAGE_BIOMETRIC" />
    <!-- FaceManager reads the sensor properties before it will enroll. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC_INTERNAL" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Launched by Settings in place of its own FaceEnrollEnrolling, via
             config_face_enroll. Exported so Settings can reach it, and gated on the
             same permission the enrollment itself needs. -->
        <activity
            android:name=".FaceEnrollActivity"
            android:exported="true"
            android:permission="android.permission.MANAGE_BIOMETRIC"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
