# /proc/vendor_sched is Google's scheduler tuning interface on this SoC: uclamp limits,
# prefer_idle, dvfs_headroom, boost_at_fork and the rest. task_profiles.json writes it when a
# task changes group, from whichever process makes the change.
#
# Stock lets every domain but apps read the directory and write the files, through a rule on
# an attribute expression the recovery tool cannot lift, so it is written out here. An
# earlier version of this file granted a handful of domains and called that a divergence from
# stock, going by Google's denial metadata; stock's compiled policy grants all of them.
allow { domain -appdomain -rs } proc_vendor_sched:dir r_dir_perms;
allow { domain -appdomain -rs } proc_vendor_sched:file w_file_perms;
