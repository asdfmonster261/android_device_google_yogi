# init-mm-logging-sh
dontaudit init-mm-logging-sh self:capability { sys_ptrace };

# insmod-sh
dontaudit insmod-sh insmod-sh:key { write };
dontaudit insmod-sh proc_cmdline:file { getattr ioctl lock map open read watch watch_reads };

# installd
dontaudit installd modem_img_file:filesystem { quotaget };

# modem_logging
dontaudit modem_logging dumpstate:fd { use };
dontaudit modem_logging dumpstate:fifo_file { write };

# mtk_remotefsd
dontaudit mtk_remotefsd self:capability { net_admin };

# rebalance_interrupts_vendor
