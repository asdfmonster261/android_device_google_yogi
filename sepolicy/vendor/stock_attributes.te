typeattribute dump_iommu hal_dumpstate;
typeattribute dump_mailbox hal_dumpstate;
typeattribute dump_memory hal_dumpstate;
typeattribute dump_modem_log hal_dumpstate;
typeattribute dump_modem_syslog hal_dumpstate;
typeattribute dump_pcie hal_dumpstate;
typeattribute dump_perf hal_dumpstate;
typeattribute dump_pixel_display hal_dumpstate;
typeattribute dump_pixel_display_userdebug hal_dumpstate;
typeattribute dump_pixel_metrics hal_dumpstate;
typeattribute dump_pixel_second_display hal_dumpstate;
typeattribute dump_power hal_dumpstate;
typeattribute dump_ramdump hal_dumpstate;
typeattribute dump_sensors hal_dumpstate;
