# Attributes stock gives these types that our generated declarations left out. Recovered
# from stock's policy source, not the compiled policy, because the compiler expands some
# attributes away. Each one is what lets an existing rule reach the type: apps calling the
# TPU services rely on binderservicedomain and app_api_service, for example.

typeattribute edgetpu_dba_server binderservicedomain;
typeattribute edgetpu_tachyon_server binderservicedomain;
typeattribute edgetpu_vendor_server binderservicedomain;
typeattribute edgetpu_device isolated_compute_allowed_device;
typeattribute edgetpu_device mlstrustedobject;
typeattribute edgetpu_nnapi_service app_api_service;
typeattribute edgetpu_nnapi_service isolated_compute_allowed_service;
typeattribute edgetpu_tachyon_service app_api_service;
typeattribute edgetpu_tachyon_service isolated_compute_allowed_service;

typeattribute hal_face_ext_service protected_service;
typeattribute mtk_wwan_device mlstrustedobject;

typeattribute lbs_service netdomain;
typeattribute mdl_coll netdomain;
typeattribute metad netdomain;

