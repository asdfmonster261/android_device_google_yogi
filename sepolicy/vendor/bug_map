# Denials this device is expected to take, in the format logd reads
# (scontext tcontext tclass tag). Listing one here grants nothing: it annotates the
# denial in bug reports so a genuinely new one stands out instead of being lost among
# the expected ones. The file ships as vendor/etc/selinux/selinux_denial_metadata.
#
# Every entry was checked one at a time against the stock policy for this device.
# The tags mean:
#   yogi/stock-denies      stock has no rule for it either, so stock takes the same denial
#   yogi/provider-absent   the service exists only if a Google app we do not ship registers it
#   aosp/neverallow        AOSP forbids granting it, so it cannot be fixed by a rule
#
# Denials from the adb shell reaching HALs are deliberately absent: they happen only
# while someone is running dumpsys, not during a boot, and listing them would hide a
# real shell-domain problem later.


edgetpu_tachyon_server default_android_service service_manager yogi/provider-absent

hal_camera_default default_android_service service_manager yogi/provider-absent
hal_camera_default default_prop file aosp/neverallow
hal_camera_default shell_data_file dir yogi/stock-denies
hal_camera_default system_data_file dir yogi/stock-denies
hal_camera_default system_userdir_file dir yogi/stock-denies

hal_face_default default_prop file aosp/neverallow

hal_graphics_composer_default default_prop file aosp/neverallow

hal_input_processor_default default_prop file aosp/neverallow

hal_power_default hal_power_default capability yogi/stock-denies

hal_thermal_default default_prop file aosp/neverallow

init debugfs lnk_file yogi/stock-denies
init vendor_mdota_custom_dir dir yogi/stock-denies

insmod debugfs_fwtp dir yogi/stock-denies
insmod insmod key yogi/stock-denies
insmod proc_cmdline file yogi/stock-denies

logd proc_vendor_sched file yogi/stock-denies

rebalance_interrupts_vendor rebalance_interrupts_vendor capability yogi/stock-denies

rild default_prop file aosp/neverallow
rild default_prop property_service aosp/neverallow
rild rild packet_socket yogi/stock-denies

surfaceflinger vendor_display_prop file yogi/stock-denies

system_app default_prop property_service aosp/neverallow

toolbox ram_device blk_file yogi/stock-denies

vendor_init default_prop file aosp/neverallow
vendor_init default_prop property_service aosp/neverallow
